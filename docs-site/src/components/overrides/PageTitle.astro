---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { pageMeta } from "../../lib/meta";
const meta = await pageMeta(Astro.locals.starlightRoute.entry);
const stability = meta?.stability ?? "stable";
const tracking = meta?.tracking ?? [];
const ru = Astro.currentLocale === "ru";
const links = tracking.map((n) => ({ n, href: `https://github.com/andreypfau/mcrs/issues/${n}` }));
const text = stability === "changing"
  ? (ru ? "Меняется. Следите:" : "Changing. Follow:")
  : (ru ? "WIP: пока не реализовано или реализовано частично. Следите:" : "WIP: not implemented yet or partly. Follow:");
---
<Default><slot /></Default>
{stability !== "stable" && (
  <div class={`mcrs-banner ${stability}`}>
    {text} {links.map((l, i) => <>{i > 0 && ", "}<a href={l.href}>#{l.n}</a></>)}
  </div>
)}
