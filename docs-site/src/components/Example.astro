---
import { readFileSync, existsSync } from "node:fs";
import path from "node:path";
import { Code } from "@astrojs/starlight/components";
import { REPO } from "~/config.mjs";
import { extractByAnchor } from "~/lib/anchor.mjs";
interface Props { file: string; from?: string; to?: string; title?: string }
const { file, from, to, title, ...rest } = Astro.props;
if (from === undefined && to !== undefined) throw new Error(`Example ${file}: "to" needs "from"`);
if ("lines" in rest) throw new Error(`Example: "lines" is gone, pass from="..." (and to="...") with text from ${file}`);
// docs-site lives one level below the repository root; the build runs from docs-site.
const full = path.resolve(process.cwd(), "..", file);
if (!existsSync(full)) throw new Error(`Example: file not found in repository: ${file}`);
const text = readFileSync(full, "utf8");
let code = text.replace(/\n$/, ""), first = 1, last = code.split("\n").length;
if (from !== undefined) {
  try {
    ({ code, from: first, to: last } = extractByAnchor(text, from, to));
  } catch (e) {
    throw new Error(`Example ${file}: ${(e as Error).message}`);
  }
}
const ext = path.extname(file).slice(1);
const lang = ({ rs: "rust", yml: "yaml", md: "md" } as Record<string, string>)[ext] ?? ext;
const url = `${REPO}/blob/main/${file}` + (from !== undefined ? `#L${first}-L${last}` : "");
---
<Code code={code} lang={lang} title={title ?? file} />
<p><a href={url}>{file}{from !== undefined ? `:${first}-${last}` : ""}</a></p>
