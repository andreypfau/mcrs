    },
    { "id": "join_alice", "join": "Alice" },
    { "id": "join_bob", "join": "Bob" },
    {
      "id": "prepare_arena",
      "console": {
        "lines": [
          "difficulty peaceful",
          "gamerule spawn_mobs false",
          "kill @e[type=!minecraft:player]",
          "fill -5 99 -5 5 99 5 minecraft:stone",
          "fill -5 100 -5 5 104 5 minecraft:air",
          "tp Alice 0 100 0",
          "tp Bob 2 100 0",
          "gamemode creative Alice",
          "gamemode creative Bob",
          "summon minecraft:pig 1 100 0 {UUID:[I;0,0,0,8],NoAI:1b}",
          "summon minecraft:armor_stand 1 100 1 {UUID:[I;0,0,0,7],NoGravity:1b}",
          "summon minecraft:item 1 100 -2 {UUID:[I;0,0,0,6],PickupDelay:32767s,Item:{id:\"minecraft:stone\",count:1}}",
          "item replace entity Alice weapon.mainhand with minecraft:stick[minecraft:interact_animation={type:\"none\",duration:25},minecraft:attack_animation={type:\"none\",duration:19}]",
          "item replace entity Alice weapon.offhand with minecraft:stick[minecraft:interact_animation={type:\"none\",duration:33}]",
          "scoreboard objectives add swing_res dummy"
        ]
      }
    },
