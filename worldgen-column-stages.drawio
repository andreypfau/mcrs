        <mxCell id="n13" value="Шаги 0–8: raw_generation, lakes,&#xa;local_modifications, underground_structures,&#xa;surface_structures, underground_ores,&#xa;underground_decoration, fluid_springs.&#xa;Шаг 5 strongholds пуст во всех биомах,&#xa;его рунг схлопывается." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=Helvetica;fontSize=12;" parent="1" vertex="1">
