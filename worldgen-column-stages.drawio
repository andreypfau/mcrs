        <mxCell id="n22" value="Шаг 9: vegetal_decoration.&#xa;Единственные блоки с проверкой&#xa;выживания живут здесь." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=Helvetica;fontSize=12;" parent="1" vertex="1">
