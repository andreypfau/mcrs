        <mxCell id="t1" value="Предлагаемая лестница: рунг на группу шагов" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=20;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="30" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Стадия Run разрезается на рунги. Рунг k читает мир, слитый по рунгу k−1, поэтому фича никогда не видит устаревшую землю под собой. Правило проверяется локально, по своему 3×3, и транзитивно вынуждает всю воронку." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="62" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Ступень" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="Что должно быть готово" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="380" y="130" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="Радиус вокруг&#xa;отдаваемой колонки" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="940" y="124" width="180" height="40" as="geometry" />
