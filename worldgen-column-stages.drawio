          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o41" value="Откуда берутся два кольца на рунг&#xa;&#xa;Слияние рунга k у колонки требует, чтобы рунг k прогнали все, кто в неё&#xa;пишет, — это её 3×3, кольцо номер один. Чтобы они могли его прогнать,&#xa;их собственное окно чтения должно быть финальным по рунгу k−1 —&#xa;это кольцо номер два. Отсюда радиус филла = D + 2L." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="1102" width="760" height="150" as="geometry" />
        </mxCell>
        <mxCell id="o42" value="Цена и планировщик&#xa;&#xa;Рунг, в который никто не записал, сливается передачей Arc без копирования;&#xa;перестройка карт высот случается только там, где записи есть.&#xa;Планировщик не ждёт: колонка, у которой рунг ещё не готов, пропускается,&#xa;и воркер берёт следующую из очереди по приоритету." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="840" y="1102" width="760" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
