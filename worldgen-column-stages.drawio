        <mxCell id="n10" value="Run рунг 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=Helvetica;fontSize=12;" parent="1" vertex="1">
